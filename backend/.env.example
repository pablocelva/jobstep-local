# ==============================================================================
# JobStep Local — Configuración de Entorno (.env.example)
# ==============================================================================

# --- Modo de Base de Datos ---
# Opciones:
# 1) Tu PostgreSQL local (visible en tu pgAdmin):
#    DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/jobstep_local
# 2) Modo Portable / SQLite Embebido (usado automáticamente si Postgres no tiene credenciales configuradas o para el .exe/.dmg):
#    DATABASE_URL=sqlite:///../storage/jobstep_local.db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/jobstep_local
 AUTO_FALLBACK_SQLITE=true

# --- Motor de IA Dual (Strategy Pattern) ---
# Proveedor por defecto: "groq" | Alternativa 100% local: "ollama"
LLM_PROVIDER=groq

# --- Configuración Groq API (Default) ---
GROQ_API_KEY=tu_api_key_de_groq_aqui
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_SEARCH_MODEL=groq/compound

# --- Configuración Ollama Local (Switchable) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1:8b

# --- Almacenamiento Local de Ofertas y CVs ---
STORAGE_DIR=../storage
MAX_UPLOAD_SIZE_MB=10
